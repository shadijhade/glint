msgid "Trust it and test again"
msgstr "Vertrauen und erneut testen"

#: crates/glint-ui/src/dialogs/remote.rs
msgid "Connecting…"
msgstr "Verbindung wird hergestellt…"

#: crates/glint-ui/src/dialogs/remote.rs
