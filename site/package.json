{
  "name": "glint-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "glint.rafd.tech, Glint's home page: Astro, GSAP and a WebGL field, published as a Cloudflare Worker",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
