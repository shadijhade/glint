---
/*
  06 Proof: the README's benchmark table. Each time gets a bar on a log scale from 0.1 ms to 1 s, so a
  0.4 ms and a 114 ms both read; a blink would start at the dashed line.
*/
import { PROOF, SITE } from "../content/site";
import Icon from "./Icon.astro";
import Label from "./Label.astro";
import Lines from "./Lines.astro";

const LO = Math.log10(0.1);
const HI = Math.log10(1000);
const at = (ms: number) => ((Math.log10(ms) - LO) / (HI - LO)) * 100;
const blink = at(100);
---

<section class="chapter proof" id="proof" data-chapter="proof" data-scene="1">
  <div class="wrap">
    <div class="proof-head">
      <div>
        <Label index={6} text={PROOF.label} />
        <Lines lines={PROOF.lines} />
      </div>
      <a class="btn btn-ghost" href={SITE.benchmarks} data-reveal>
        <span>The benchmarks on GitHub</span>
        <Icon name="external" />
      </a>
    </div>

    <div class="table-wrap glass" data-reveal>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Task</th>
            <th scope="col">Where</th>
            <th scope="col" class="t-found">Found</th>
            <th scope="col" class="t-time">Time</th>
            <th scope="col" class="t-bar">
              <span class="sr-only">On a log scale; a blink starts at 100 ms</span>
              <span class="scale mono" aria-hidden="true"><span>0.1 ms</span><span style={`left:${blink}%`}>a blink</span><span>1 s</span></span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            PROOF.rows.map((r) => (
              <tr data-proof-row>
                <th scope="row">{r.task}</th>
                <td class="t-where">{r.where}</td>
                <td class="t-found mono">{r.found}</td>
                <td class="t-time num">
                  <span data-count={r.ms} data-decimals={r.ms < 10 && r.ms % 1 ? 1 : 0}>{r.ms}</span>
                  <span class="unit">ms</span>
                </td>
                <td class="t-bar" aria-hidden="true">
                  <span class="bar" style={`--w:${at(r.ms).toFixed(1)}%;--blink:${blink}%`}><span /></span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="method" data-reveal>{PROOF.method}</p>
  </div>
</section>

<style>
  .proof-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .table-wrap {
    overflow-x: auto;
    padding: 8px clamp(8px, 1.6vw, 22px);
  }

  .table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .table th,
  .table td {
    padding: 15px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }

  .table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .table thead th {
    color: var(--fog);
    font: 500 11px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .table tbody th {
    color: var(--snow);
    font-weight: 400;
  }

  .t-where {
    color: var(--mist);
  }

  .t-found {
    color: var(--fog);
    font-size: 12.5px;
  }

  .t-time {
    font-size: 1.35rem;
    text-align: right !important;
    white-space: nowrap;
  }

  .t-bar {
    width: 30%;
  }

  .scale {
    position: relative;
    display: block;
    height: 14px;
    letter-spacing: 0;
    text-transform: none;
  }

  .scale span {
    position: absolute;
    top: 0;
  }

  .scale span:first-child {
    left: 0;
  }

  .scale span:last-child {
    right: 0;
  }

  .scale span:nth-child(2) {
    translate: -50% 0;
    color: var(--pink);
  }

  .bar {
    position: relative;
    display: block;
    height: 6px;
    border-radius: 6px;
    background:
      linear-gradient(90deg, transparent calc(var(--blink) - 0.5px), rgba(255, 143, 208, 0.6) calc(var(--blink) - 0.5px), rgba(255, 143, 208, 0.6) calc(var(--blink) + 0.5px), transparent calc(var(--blink) + 0.5px)),
      rgba(255, 255, 255, 0.05);
  }

  .bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: 6px;
    background: linear-gradient(90deg, var(--gold-2), var(--gold));
    box-shadow: 0 0 14px rgba(255, 217, 102, 0.5);
  }

  :global(.motion-ok) .bar span {
    transform: scaleX(0);
    transform-origin: left;
  }

  :global(.motion-ok) [data-proof-row]:global(.is-in) .bar span {
    transform: none;
    transition: transform 1.4s var(--ease-out);
  }

  .method {
    max-width: 90ch;
    margin-top: 22px;
    color: var(--fog);
    font-size: 13.5px;
  }

  /* On a phone the table keeps what matters: the task, where, and the time. */
  @media (max-width: 720px) {
    .table {
      min-width: 0;
      font-size: 14px;
    }

    .t-found,
    .t-bar {
      display: none;
    }

    .table th,
    .table td {
      padding: 13px 8px;
    }

    .t-time {
      font-size: 1.15rem;
    }
  }
</style>
