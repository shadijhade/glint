---
/* 05 Still Windows: what Glint keeps from Windows, and what it keeps to itself. */
import { WINDOWS } from "../content/site";
import Icon from "./Icon.astro";
import Label from "./Label.astro";
import Lines from "./Lines.astro";
---

<section class="chapter windows" id="windows" data-chapter="windows" data-scene="4">
  <div class="wrap">
    <div class="windows-head">
      <div>
        <Label index={5} text={WINDOWS.label} />
        <Lines lines={WINDOWS.lines} />
      </div>
      <p class="body" data-reveal>{WINDOWS.body}</p>
    </div>

    <ul class="cards">
      {
        WINDOWS.cards.map((c, i) => (
          <li class="card glass" data-reveal style={`--d:${i * 70}ms`} data-tilt>
            <span class="card-icon">
              <Icon name={c.icon as "engine"} />
            </span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .windows-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: clamp(28px, 5vw, 80px);
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(24px, 2.6vw, 34px);
    transition:
      border-color 0.4s,
      transform 0.6s var(--ease-out);
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), rgba(255, 143, 208, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  .card:hover {
    border-color: rgba(255, 143, 208, 0.32);
  }

  .card:hover::before {
    opacity: 1;
  }

  .card-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
    border: 1px solid rgba(255, 217, 102, 0.3);
    border-radius: 14px;
    background: radial-gradient(circle at 30% 20%, rgba(255, 217, 102, 0.18), rgba(255, 143, 208, 0.06));
    color: var(--gold);
  }

  .card-icon :global(.icon) {
    width: 24px;
    height: 24px;
  }

  /* Each icon draws itself as its card arrives. */
  :global(.motion-ok) .card-icon :global(.icon) :global(*) {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
  }

  :global(.motion-ok) .card:global(.is-in) .card-icon :global(.icon) :global(*) {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--ease-out) calc(var(--d) + 0.25s);
  }

  :global(.motion-ok) .card:global(.is-in) {
    transition-delay: var(--d);
  }

  .card h3 {
    font: 600 1.15rem/1.3 var(--font-display);
    letter-spacing: -0.01em;
  }

  .card p {
    color: var(--mist);
    font-size: 15px;
  }

  @media (max-width: 1000px) {
    .windows-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
