---
/*
  The field, still: the hero's drive of light as a static picture, for reduced motion, no WebGL2, and
  the moment before the live field starts. Same recipe as scenes.ts's first scene, fewer points.
*/
const W = 1440;
const H = 900;
let s = 7;
const rand = () => {
  s = (s + 0x6d2b79f5) >>> 0;
  let t = s;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const gauss = () => Math.sqrt(-2 * Math.log(rand() || 1e-9)) * Math.cos(2 * Math.PI * rand());
const COLORS = ["#ffd966", "#ffd966", "#ff8fd0", "#ffb526", "#e9ddff", "#ffffff"];
const cx = W * 0.7;
const cy = H * 0.48;
const R = Math.min(W * 0.42, H * 0.62);
const dots = Array.from({ length: 380 }, () => {
  const u = rand();
  let x: number;
  let y: number;
  if (u < 0.04) {
    x = cx + gauss() * R * 0.12;
    y = cy + gauss() * R * 0.07;
  } else if (u < 0.2) {
    x = rand() * W;
    y = rand() * H;
  } else {
    const arm = Math.floor(rand() * 3);
    const t = Math.pow(rand(), 0.7);
    const rad = R * (0.08 + 0.92 * t);
    const ang = (arm * 2 * Math.PI) / 3 + t * 3.6 + gauss() * 0.28 * (1.1 - t);
    x = cx + Math.cos(ang) * rad + gauss() * R * 0.03;
    y = cy + Math.sin(ang) * rad * 0.58 + gauss() * R * 0.025;
  }
  return { x: x.toFixed(1), y: y.toFixed(1), r: (0.6 + rand() * 1.4).toFixed(2), c: COLORS[Math.floor(rand() * COLORS.length)], o: (0.25 + rand() * 0.65).toFixed(2) };
});
---

<svg class="field-still" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="still-core">
      <stop offset="0" stop-color="#fff1b8" stop-opacity="0.55"></stop>
      <stop offset="0.25" stop-color="#ff8fd0" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#c026d3" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <ellipse cx={cx} cy={cy} rx={R * 0.55} ry={R * 0.36} fill="url(#still-core)"></ellipse>
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.c} fill-opacity={d.o} />)}
</svg>
