---
/* 05 Get Glint: the download and why to trust it, the other ways in, and the questions people ask. */
import { GET, SITE } from "../content/site";
import Icon from "./Icon.astro";
import Label from "./Label.astro";
import Lines from "./Lines.astro";
---

<section class="chapter get" id="get" data-chapter="get">
  <div class="wrap">
    <!-- The field draws Glint's mark in the space above the download (scene 5), then lies down as a
         horizon under the ways in and the questions (scene 4). -->
    <div class="get-hero" data-scene="5">
      <Label index={5} text={GET.label} />
      <Lines lines={GET.lines} class="display" />
      <p class="lead get-body" data-reveal>{GET.body}</p>
      <div class="get-cta" data-reveal>
        <a class="btn btn-primary btn-xl" href={SITE.download} data-download>
          <Icon name="download" />
          <span>Download for Windows</span>
        </a>
        <p class="get-meta mono"><span data-release></span>{GET.requirements}</p>
      </div>
      <ul class="trust" data-reveal>
        {
          GET.trust.map((t) => (
            <li>
              <Icon name={t.icon as "engine"} />
              {t.text}
            </li>
          ))
        }
      </ul>
      <p class="smartscreen" data-reveal>{GET.smartscreen}</p>
    </div>

    <div class="get-more" data-scene="4">
      <div class="ways" data-reveal>
        {
          GET.ways.map((w) => (
            <div class="way">
              <h3>{w.title}</h3>
              <div class="cmds">
                {w.commands.map((c) => (
                  <div class="cmd">
                    <code>{c}</code>
                    <button class="copy" type="button" data-copy={c} aria-label={`Copy: ${c}`}>
                      <Icon name="copy" class="copy-idle" />
                      <Icon name="check" class="copy-done" />
                    </button>
                  </div>
                ))}
              </div>
              <p>{w.note}</p>
            </div>
          ))
        }
        <div class="way">
          <h3>Other ways</h3>
          <a class="way-link" href={SITE.latest} data-offline-link data-offline hidden>
            <Icon name="download" />
            <span>The offline installer, with WebView2 inside</span>
          </a>
          <a class="way-link" href={SITE.source}>
            <Icon name="code" />
            <span>Build it from the source</span>
          </a>
          <a class="way-link" href={SITE.releases}>
            <Icon name="external" />
            <span>Every release on GitHub</span>
          </a>
        </div>
      </div>

      <div class="faq">
        {
          GET.faq.map((f) => (
            <details class="qa" data-reveal>
              <summary>
                {f.q}
                <span class="qa-mark" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
        <p class="faq-more" data-reveal>
          More in the <a href={SITE.repo}>README</a>, the <a href={SITE.privacy}>privacy policy</a> and <a href={SITE.instantSearch}>how instant search works</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .get-hero {
    display: grid;
    justify-items: center;
    align-content: start;
    max-width: 920px;
    min-height: 92vh;
    min-height: 92svh;
    margin-inline: auto;
    padding-top: max(32vh, 210px);
    text-align: center;
  }

  /* No field, no mark to make room for. */
  :global(html:not(.motion-ok)) .get-hero {
    min-height: 0;
    padding-top: 0;
  }

  .get-hero :global(.label) {
    justify-content: center;
  }

  .get-hero :global(.display) {
    font-size: clamp(2.6rem, 1.4rem + 5vw, 6rem);
  }

  .get-body {
    max-width: 30ch;
    margin-top: 24px;
  }

  .get-cta {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: 34px;
  }

  .btn-xl {
    min-height: 68px;
    padding: 0 40px;
    font-size: 18px;
    box-shadow:
      0 24px 80px -16px rgba(255, 181, 38, 0.6),
      0 0 0 10px rgba(255, 217, 102, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .btn-xl :global(.icon) {
    width: 21px;
    height: 21px;
  }

  .get-meta {
    color: var(--fog);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-top: 30px;
    color: var(--mist);
    font-size: 14.5px;
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .trust :global(.icon) {
    width: 17px;
    height: 17px;
    color: var(--gold);
  }

  .smartscreen {
    max-width: 62ch;
    margin-top: 18px;
    color: var(--fog);
    font-size: 13.5px;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(56px, 7vw, 88px);
  }

  .way {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 12px;
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--glass);
    backdrop-filter: blur(14px);
  }

  .way h3 {
    font: 600 1.1rem var(--font-display);
  }

  .way p {
    color: var(--mist);
    font-size: 14px;
  }

  .way-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--snow);
    font-size: 14.5px;
  }

  .way-link[hidden] {
    display: none;
  }

  .way-link :global(.icon) {
    width: 16px;
    height: 16px;
    color: var(--pink);
  }

  .way-link:hover span {
    text-decoration: underline;
    text-decoration-color: rgba(255, 143, 208, 0.45);
    text-underline-offset: 3px;
  }

  .cmds {
    display: grid;
    gap: 8px;
    width: 100%;
  }

  .cmd {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 9px 9px 9px 13px;
    border-radius: 10px;
    background: rgba(6, 3, 11, 0.6);
  }

  .cmd code {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--gold-hi);
    font: 400 12.5px/1.5 var(--font-mono);
  }

  .copy {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--fog);
    transition:
      color 0.3s,
      background-color 0.3s;
  }

  .copy:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--snow);
  }

  .copy :global(.icon) {
    width: 15px;
    height: 15px;
  }

  .copy :global(.copy-done),
  .copy:global(.is-copied) :global(.copy-idle) {
    display: none;
  }

  .copy:global(.is-copied) :global(.copy-done) {
    display: block;
    color: var(--gold);
  }

  .faq {
    max-width: 860px;
    margin: clamp(56px, 7vw, 88px) auto 0;
  }

  .qa {
    border-bottom: 1px solid var(--line);
  }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 1.05rem;
    font-weight: 400;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa-mark {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .qa-mark::before,
  .qa-mark::after {
    content: "";
    position: absolute;
    inset: 6.5px 0 auto;
    height: 1.5px;
    border-radius: 2px;
    background: var(--pink);
    transition: transform 0.4s var(--ease-out);
  }

  .qa-mark::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa-mark::after {
    transform: rotate(0);
  }

  .qa p {
    max-width: 70ch;
    padding: 0 4px 20px;
    color: var(--mist);
  }

  .faq-more {
    margin-top: 22px;
    color: var(--fog);
    font-size: 14px;
  }

  .faq-more a {
    color: var(--pink);
    text-decoration: underline;
    text-decoration-color: rgba(255, 143, 208, 0.4);
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .btn-xl {
      width: 100%;
      padding: 0 24px;
      font-size: 17px;
    }

    .trust {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
