---
/*
  04 More: six things File Explorer leaves out, each with the README's screenshot (AVIF and WebP made
  at build time), then a line of the rest. A grid on a wide screen; a row to swipe on a phone, so the
  page stays short.
*/
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { MORE, SITE } from "../content/site";
import Icon from "./Icon.astro";
import Label from "./Label.astro";
import Lines from "./Lines.astro";

const shots = import.meta.glob<{ default: ImageMetadata }>("../../../screenshots/*.png", { eager: true });
const shot = (name: string) => {
  const found = Object.entries(shots).find(([path]) => path.endsWith(`/${name}.png`));
  if (!found) throw new Error(`screenshots/${name}.png is missing`);
  return found[1].default;
};
---

<section class="chapter more" id="more" data-chapter="more" data-scene="4">
  <div class="wrap">
    <div class="more-head">
      <Label index={4} text={MORE.label} />
      <Lines lines={MORE.lines} />
    </div>

    <ul class="cards">
      {
        MORE.cards.map((c, i) => (
          <li class="card" data-reveal style={`--d:${i * 60}ms`}>
            <figure class="frame">
              <Picture
                src={shot(c.shot)}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[480, 720, 960]}
                sizes="(max-width: 720px) 82vw, (max-width: 1100px) 46vw, 410px"
                alt={c.alt}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="also" data-reveal>
      <p class="also-title mono">Also in Glint</p>
      <ul>
        {MORE.also.map((a) => <li>{a}</li>)}
      </ul>
      <a class="also-link" href={SITE.features}>
        <span>Everything Glint does</span>
        <Icon name="external" />
      </a>
    </div>
  </div>
</section>

<style>
  .more-head {
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 28px);
  }

  .card {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  :global(.motion-ok) .card:global(.is-in) {
    transition-delay: var(--d);
  }

  .card .frame {
    aspect-ratio: 16 / 10;
    margin-bottom: 10px;
  }

  .card .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .card h3 {
    font: 600 1.15rem/1.3 var(--font-display);
    letter-spacing: -0.01em;
  }

  .card p {
    color: var(--mist);
    font-size: 15px;
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .also-title {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .also ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .also li {
    padding: 5px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--mist);
    font-size: 13.5px;
    text-shadow: none;
  }

  .also-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
    color: var(--pink);
    font-size: 14.5px;
  }

  .also-link :global(.icon) {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* On a phone: one row to swipe through, so six screenshots don't make the page six screens longer. */
  @media (max-width: 720px) {
    .cards {
      display: flex;
      gap: 14px;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .cards::-webkit-scrollbar {
      display: none;
    }

    .card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .also ul {
      flex-wrap: nowrap;
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .also ul::-webkit-scrollbar {
      display: none;
    }

    .also li {
      flex: none;
      white-space: nowrap;
    }

    .also-link {
      margin-inline-start: 0;
    }
  }
</style>
