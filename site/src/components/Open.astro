---
/*
  01 Open. The measured times of four folders on a 0 to 400 ms scale, against the span of a blink;
  beside it, System32 as Glint lists it, its names read at build time from the search demo's corpus.
*/
import names from "../../public/data/names.txt?raw";
import { OPEN } from "../content/site";
import Label from "./Label.astro";
import Lines from "./Lines.astro";

const SCALE = 400;
const pct = (ms: number) => `${((ms / SCALE) * 100).toFixed(2)}%`;

// A stretch of System32 around kernel32.dll, as the list would show it sorted by name.
const corpus = names.split(/\r?\n/);
const start = corpus.indexOf(">C:\\Windows\\System32") + 1;
const end = corpus.findIndex((line, i) => i > start && line.startsWith(">"));
const system32 = corpus.slice(start, end).filter((n) => n.includes("."));
const at = Math.max(0, system32.findIndex((n) => n.toLowerCase() === "kernel32.dll") - 6);
const rows = system32.slice(at, at + 15);
const TYPES: Record<string, string> = {
  dll: "Application extension",
  exe: "Application",
  sys: "System file",
  mui: "MUI file",
  cpl: "Control panel item",
  msc: "Console document",
  xml: "XML document",
  ini: "Configuration settings",
  tlb: "Type library",
  nls: "NLS file",
};
const typeOf = (name: string) => TYPES[name.split(".").pop()?.toLowerCase() ?? ""] ?? "File";
---

<section class="chapter open" id="open" data-chapter="open" data-scene="1">
  <div class="wrap open-grid">
    <div class="open-copy">
      <Label index={1} text={OPEN.label} />
      <Lines lines={OPEN.lines} />
      <p class="body open-body" data-reveal>{OPEN.body}</p>
    </div>

    <figure class="window glass" data-reveal data-listing aria-label="System32 open in Glint: 5,092 items on screen in 12 ms">
      <div class="window-bar">
        <span class="crumbs mono">Local Disk (C:) <i>›</i> Windows <i>›</i> System32</span>
        <span class="stopwatch mono" aria-hidden="true"><span data-stopwatch>12</span> ms</span>
      </div>
      <div class="window-head mono" aria-hidden="true"><span>Name</span><span>Type</span></div>
      <ol class="window-rows" aria-hidden="true">
        {rows.map((name, i) => (
          <li class:list={{ hit: name.toLowerCase() === "kernel32.dll" }} style={`--i:${i}`}>
            <span class="file-name">{name}</span>
            <span class="file-type">{typeOf(name)}</span>
          </li>
        ))}
      </ol>
      <figcaption class="window-status mono">
        <span>5,092 items</span>
        <span class="status-time">on screen in 12 ms</span>
      </figcaption>
    </figure>
  </div>

  <div class="wrap">
    <figure class="blink" data-blink>
      <figcaption class="sr-only">
        Time to open a folder in Glint against the length of a blink: {OPEN.marks.map((m) => `${m.where}, ${m.what}, ${m.ms} ms`).join("; ")}. A blink takes {OPEN.blink.from} to {OPEN.blink.to} ms.
      </figcaption>
      <div class="blink-track" aria-hidden="true">
        <div class="blink-band" style={`left:${pct(OPEN.blink.from)};right:0`}>
          <span class="blink-label mono">{OPEN.blink.label} · {OPEN.blink.from}–{OPEN.blink.to} ms</span>
          <span class="lid lid-top"></span>
          <span class="lid lid-bottom"></span>
        </div>
        <div class="blink-sweep" data-blink-sweep></div>
        {
          OPEN.marks.map((m, i) => (
            <div class:list={["mark", `mark-${i}`]} style={`left:${pct(m.ms)}`} data-blink-mark>
              <span class="mark-dot" />
              <span class="mark-text">
                <span class="mark-ms num">{m.ms}<span class="unit">ms</span></span>
                <span class="mark-where">{m.where}</span>
                <span class="mark-what mono">{m.what}</span>
              </span>
            </div>
          ))
        }
      </div>
      <div class="blink-axis mono" aria-hidden="true">
        {[0, 100, 200, 300, 400].map((t) => <span style={`left:${pct(t)}`}>{t} ms</span>)}
      </div>
      <ol class="blink-legend" aria-hidden="true">
        {OPEN.marks.map((m) => (
          <li><span class="num">{m.ms}<span class="unit">ms</span></span> {m.where} <span class="mono">{m.what}</span></li>
        ))}
      </ol>
      <p class="blink-source mono">
        <button type="button" class="replay" data-blink-replay>Replay, eight times slower</button>
        <a href={OPEN.source.href}>{OPEN.source.text}</a>
      </p>
    </figure>
  </div>
</section>

<style>
  .open-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .open-body {
    margin-top: 28px;
  }

  .window {
    overflow: hidden;
    border-radius: 16px;
    font-size: 13px;
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .crumbs {
    color: var(--mist);
    font-size: 12px;
  }

  .crumbs i {
    margin-inline: 6px;
    color: var(--fog);
    font-style: normal;
  }

  .stopwatch {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 217, 102, 0.1);
    color: var(--gold);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .window-head,
  .window-rows li {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 16px;
    padding: 0 16px;
  }

  .window-head {
    padding-block: 9px;
    color: var(--fog);
    font-size: 11px;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--line);
  }

  .window-rows li {
    align-items: center;
    height: 30px;
    color: var(--snow);
    font-weight: 300;
    text-shadow: none;
  }

  .window-rows li:nth-child(odd) {
    background: rgba(255, 255, 255, 0.015);
  }

  .window-rows li.hit {
    background: linear-gradient(90deg, rgba(236, 72, 153, 0.22), rgba(236, 72, 153, 0.06));
    box-shadow: inset 2px 0 0 var(--rose);
  }

  .file-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .file-name::before {
    content: "";
    display: inline-block;
    width: 11px;
    height: 13px;
    margin-inline-end: 10px;
    vertical-align: -2px;
    border-radius: 2px;
    background: linear-gradient(180deg, #e8e6f0, #b9b6c8);
    clip-path: polygon(0 0, 70% 0, 100% 28%, 100% 100%, 0 100%);
  }

  .file-type {
    overflow: hidden;
    color: var(--fog);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .window-status {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    color: var(--fog);
    font-size: 11.5px;
  }

  .status-time {
    color: var(--pink);
  }

  /* The rows arrive faster than the eye can follow, then the stopwatch settles on 12. */
  :global(.motion-ok) .window-rows li {
    opacity: 0;
  }

  :global(.motion-ok) [data-listing]:global(.is-open) .window-rows li {
    opacity: 1;
    transition: opacity 0.18s linear calc(var(--i) * 12ms);
  }

  /* ---------- The blink scale ---------- */
  .blink {
    margin-top: clamp(80px, 10vw, 140px);
  }

  .blink-track {
    position: relative;
    height: 270px;
    border-bottom: 1px solid var(--line-2);
  }

  .blink-legend {
    display: none;
  }

  .blink-band {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
    border-inline-start: 1px dashed rgba(255, 143, 208, 0.5);
    background:
      repeating-linear-gradient(135deg, rgba(255, 143, 208, 0.06) 0 8px, transparent 8px 16px),
      linear-gradient(90deg, rgba(255, 143, 208, 0.12), rgba(192, 38, 211, 0.05));
  }

  .blink-label {
    position: absolute;
    top: 14px;
    left: 16px;
    color: var(--pink);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The band closes like an eyelid once the sweep reaches it. */
  .lid {
    position: absolute;
    inset-inline: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(20, 8, 30, 0.9), rgba(40, 12, 50, 0.85));
    transform: scaleY(0);
  }

  .lid-top {
    top: 0;
    transform-origin: top;
  }

  .lid-bottom {
    bottom: 0;
    transform-origin: bottom;
  }

  .blink-sweep {
    position: absolute;
    top: -10px;
    bottom: -1px;
    left: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--gold));
    box-shadow: 0 0 18px var(--gold);
    opacity: 0;
  }

  .mark {
    position: absolute;
    bottom: 0;
    width: 0;
  }

  .mark-dot {
    position: absolute;
    bottom: -6px;
    left: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow:
      0 0 0 4px rgba(255, 217, 102, 0.15),
      0 0 22px rgba(255, 217, 102, 0.9);
  }

  .mark::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: -0.5px;
    width: 1px;
    height: var(--stem, 60px);
    background: linear-gradient(0deg, var(--gold), transparent);
  }

  .mark-text {
    position: absolute;
    bottom: var(--stem, 60px);
    left: 10px;
    display: grid;
    gap: 2px;
    width: max-content;
    max-width: 180px;
  }

  /* The first two marks are a few pixels apart: their labels take turns, high and low. */
  .mark-0,
  .mark-2 {
    --stem: 192px;
  }

  .mark-1,
  .mark-3 {
    --stem: 100px;
  }

  .mark-ms {
    font-size: clamp(1.4rem, 1rem + 1vw, 2rem);
    line-height: 1;
  }

  .mark-where {
    color: var(--snow);
    font-size: 13.5px;
  }

  .mark-what {
    color: var(--fog);
    font-size: 11px;
  }

  .blink-axis {
    position: relative;
    height: 30px;
    color: var(--fog);
    font-size: 11px;
  }

  .blink-axis span {
    position: absolute;
    top: 10px;
    translate: -50% 0;
    white-space: nowrap;
  }

  .blink-axis span:first-child {
    translate: 0 0;
  }

  .blink-axis span:last-child {
    translate: -100% 0;
  }

  .blink-source {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: 14px;
    color: var(--fog);
    font-size: 11px;
  }

  .replay {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-decoration-color: rgba(255, 217, 102, 0.35);
    text-underline-offset: 3px;
  }

  /* Without motion there is nothing to replay. */
  :global(html:not(.motion-ok)) .replay {
    display: none;
  }

  .blink-source a:hover {
    color: var(--mist);
  }

  :global(.motion-ok) [data-blink-mark] {
    opacity: 0;
    transform: translateY(14px);
  }

  :global(.motion-ok) [data-blink-mark]:global(.is-in) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-spring);
  }

  @media (max-width: 1000px) {
    .open-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* On a phone the marks are too close for labels: dots on the scale, a legend under it. */
  @media (max-width: 720px) {
    .blink-track {
      height: 120px;
    }

    .mark {
      --stem: 0px;
    }

    .mark-text {
      display: none;
    }

    .blink-legend {
      display: grid;
      gap: 8px;
      margin-top: 18px;
      color: var(--mist);
      font-size: 14px;
    }

    .blink-legend .num {
      display: inline-block;
      min-width: 5.2em;
      color: var(--gold);
    }

    .blink-legend .mono {
      color: var(--fog);
      font-size: 11px;
    }

    .window-head,
    .window-rows li {
      grid-template-columns: minmax(0, 1fr);
    }

    .file-type,
    .window-head span:last-child {
      display: none;
    }
  }
</style>
