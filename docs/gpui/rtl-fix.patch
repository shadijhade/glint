+/// One outline for rows of one rectangle each (the usual case), or one per rectangle when a row has
+/// several: a range across right-to-left text can show in several places on a row.
+fn frame_outlines(corners: &[Corners<Point<Pixels>>]) -> Vec<Vec<Point<Pixels>>> {
+    let several_on_a_row = corners.windows(2).any(|pair| pair[0].top_left.y == pair[1].top_left.y);
+    if several_on_a_row {
+        corners.iter().map(|rect| frame_outline_points(std::slice::from_ref(rect))).collect()
+    } else {
+        vec![frame_outline_points(corners)]
+    }
+}
